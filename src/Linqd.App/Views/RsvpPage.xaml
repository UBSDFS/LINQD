<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Linqd.App.Views.RsvpPage"
    Title="Event RSVP">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                Spacing="15">

            <Label
                Text="RSVP to Event"
                FontSize="26"
                FontAttributes="Bold"/>

            <Label
                x:Name="EventTitleLabel"
                Text="Selected Event"
                FontSize="18"/>

            <Entry
                x:Name="FirstNameEntry"
                Placeholder="First Name"/>

            <Entry
                x:Name="LastNameEntry"
                Placeholder="Last Name"/>

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email Address"
                Keyboard="Email"/>

            <Label
                Text="Your Response"
                FontAttributes="Bold"/>

            <Picker
                x:Name="ResponsePicker"
                Title="Select RSVP Response">
                <Picker.Items>
                    <x:String>Attending</x:String>
                    <x:String>Not Attending</x:String>
                    <x:String>Maybe</x:String>
                </Picker.Items>
            </Picker>

            <Button
                x:Name="SubmitRsvpButton"
                Text="Submit RSVP"
                Clicked="OnSubmitRsvpClicked"/>

            <Button
                Text="Cancel"
                Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
