<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Linqd.App.Views.ProfilePage"
    Title="Profile">

    <VerticalStackLayout Padding="25"
                         Spacing="15">

        <Label
            Text="My Profile"
            FontSize="26"
            FontAttributes="Bold"/>

        <Label
            x:Name="NameLabel"
            Text="Name:"/>

        <Label
            x:Name="UsernameLabel"
            Text="Username:"/>

        <Label
            x:Name="EmailLabel"
            Text="Email:"/>

        <Button
            x:Name="LogoutButton"
            Text="Logout"
            Clicked="OnLogoutClicked"/>
        <Button
            x:Name="LoginButton"
            Text="Log In"
            IsVisible="False"
            Clicked="OnLoginClicked"/>

        <Button
            x:Name="RegisterButton"
            Text="Register"
            IsVisible="False"
            Clicked="OnRegisterClicked"/>

    </VerticalStackLayout>
</ContentPage>
