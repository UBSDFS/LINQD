<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Linqd.App.Views.DiscoverPage"
    Title="Discover">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Discover Events"
                FontSize="28"
                FontAttributes="Bold"/>

            <Label
                Text="Explore events happening around you."
                FontSize="16"/>

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"/>

            <VerticalStackLayout
                x:Name="DiscoverEventsContainer"
                Spacing="12"/>

            <Label
                x:Name="EmptyEventsLabel"
                Text="Public events will appear here."
                IsVisible="True"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>