<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Linqd.App.Views.HomePage"
    Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <Label
                Text="Welcome to LINQD"
                FontSize="26"
                FontAttributes="Bold"/>
            <!-- Event list filters -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">

                <Button
                    x:Name="AllEventsButton"
                    Grid.Column="0"
                    Text="All"
                    Clicked="OnAllEventsClicked"/>

                <Button
                    x:Name="AttendingEventsButton"
                    Grid.Column="1"
                    Text="Attending"
                    Clicked="OnAttendingEventsClicked"/>

                <Button
                    x:Name="HostingEventsButton"
                    Grid.Column="2"
                    Text="Hosting"
                    Clicked="OnHostingEventsClicked"/>

            </Grid>

            <!-- Public event discovery -->
            <Border StrokeThickness="1"
                    Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Happening This Weekend"
                        FontSize="20"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Discover public events near you."/>

                    <VerticalStackLayout
                        x:Name="PublicEventsContainer"
                        Spacing="10"/>

                    <Label
                        x:Name="NoPublicEventsLabel"
                        Text="No public events available."/>

                </VerticalStackLayout>
            </Border>

            <!-- Private circle plans -->
            <Border StrokeThickness="1"
                    Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Your Circle's Plans"
                        FontSize="20"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Stay connected with your circle."/>

                    <VerticalStackLayout
                        x:Name="PrivateEventsContainer"
                        Spacing="10"/>

                    <Label
                        x:Name="NoPrivateEventsLabel"
                        Text="No private plans available."/>

                </VerticalStackLayout>
            </Border>

            <Button
                Text="My Profile"
                Clicked="OnProfileClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
