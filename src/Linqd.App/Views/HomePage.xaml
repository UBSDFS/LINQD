<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Linqd.App.Views.HomePage"
    Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <Label
                Text="Welcome to LINQD"
                FontSize="26"
                FontAttributes="Bold"/>

            <!-- Public event discovery -->
            <Border StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Happening This Weekend"
                        FontSize="20"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Discover public events near you."/>

                    <Label
                        Text="Public events will appear here."/>
                </VerticalStackLayout>
            </Border>

            <!-- Private circle plans -->
            <Border StrokeThickness="1"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Your Circle's Plans"
                        FontSize="20"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Stay connected with your circle."/>

                    <Label
                        Text="Private plans will appear here."/>
                </VerticalStackLayout>
            </Border>
            <Button
                Text="My Profile"
                Clicked="OnProfileClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
