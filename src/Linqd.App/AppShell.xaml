<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Linqd.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Linqd.App.Views"
    Title="LINQD">

    <!-- Entry screen -->
    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate views:WelcomePage}"
        Route="WelcomePage"/>

    <!-- Main application navigation -->
    <TabBar Route="MainTabs">

        <ShellContent
            Title="Home"
            Route="HomeTab"
            ContentTemplate="{DataTemplate views:HomePage}"/>

        <ShellContent
            Title="Discover"
            Route="DiscoverTab"
            ContentTemplate="{DataTemplate views:HomePage}"/>

        <ShellContent
            Title="Create"
            Route="CreateTab"
            ContentTemplate="{DataTemplate views:CreateEventPage}"/>

        <ShellContent
            Title="My Circle"
            Route="CircleTab"
            ContentTemplate="{DataTemplate views:HomePage}"/>

        <ShellContent
            Title="Profile"
            Route="ProfileTab"
            ContentTemplate="{DataTemplate views:ProfilePage}"/>

    </TabBar>

</Shell>
